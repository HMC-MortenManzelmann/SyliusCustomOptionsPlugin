{% set form = hookable_metadata.context.form %}

{% if form.type.vars.value in ['select', 'multi_select'] %}
    <div class="col-12">
        <div class="card mb-3">
            <div class="card-header">
                <h2 class="card-title">
                    {{ 'sylius.ui.values'|trans }}
                </h2>
            </div>
            <div class="card-body">
                {{ form_errors(form.values) }}

                <div class="row">
                    {% for value_form_key, value_form in form.values %}
                        {% hook 'values' with { value_form, value_form_key } %}
                    {% endfor %}
                </div>

                {{ form_row(form.values.vars.button_add) }}
            </div>
        </div>
    </div>
{% endif %}
