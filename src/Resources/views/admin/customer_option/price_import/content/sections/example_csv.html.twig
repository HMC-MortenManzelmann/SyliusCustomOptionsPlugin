{% set columns = ['id', 'product_code', 'customer_option_code', 'customer_option_value_code', 'channel_code', 'type', 'amount', 'percent', 'valid_from', 'valid_to', 'delete'] %}
{% set rows = [
    ['', 'tshirt_abc', 'color', 'red', 'US_WEB', 'FIXED_AMOUNT', '1500', '0', '2020-01-01', '2020-02-31', '0'],
    ['1', 'mug_def', 'material', 'metal', 'DE_WEB', 'PERCENT', '0', '0.1', '', '', '0'],
    ['2', 'pants_ghi', '', '', '', '', '', '', '', '', '1'],
] %}

<div class="col-12">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">{{ 'brille24.ui.example_csv'|trans }}</h2>
            <div class="card-actions">
                <a href="{{ path('brille24_customer_option_price_import_example_file') }}" class="btn">
                    {{ ux_icon('tabler:download', { class: 'icon' }) }}
                    {{ 'brille24.ui.download_example'|trans }}
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        {% for column in columns %}
                            <th>{{ column }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            {% for cell in row %}
                                <td>{{ cell }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
