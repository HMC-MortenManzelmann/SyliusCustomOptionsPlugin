{% set form = hookable_metadata.context.form %}

<div class="col-12">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'brille24.ui.validators'|trans }}
            </h2>
        </div>
        <div class="card-body" data-form-type="collection" id="{{ form.validators.vars.id }}">
            {{ form_errors(form.validators) }}

            {% for validator_form in form.validators %}
                {% hook 'validators' with { validator_form } %}
            {% endfor %}

            {{ form_row(form.validators.vars.button_add) }}
        </div>
    </div>
</div>
